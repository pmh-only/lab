worker_processes 1;
pid /run/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
  access_log off;
  client_body_temp_path /run/client_body;
  proxy_temp_path /run/proxy;
  fastcgi_temp_path /run/fastcgi;
  uwsgi_temp_path /run/uwsgi;
  scgi_temp_path /run/scgi;
  server {
    listen 8080;
    server_name _;
    location / {
      proxy_pass http://127.0.0.1:51515;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      # OIDC is enforced by Envoy. This Pod-local credential never reaches the
      # browser and the password-protected native server binds only loopback.
      proxy_set_header Authorization "${KOPIA_BASIC_AUTH}";
      proxy_set_header Connection "";
      proxy_set_header X-Forwarded-Proto https;
      proxy_buffering off;
      proxy_read_timeout 300s;
    }
  }
}
